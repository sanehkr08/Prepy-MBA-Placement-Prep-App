# Paste at least one key. Gemini has a free tier: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, paid or promotional credits. If set alongside Gemini, it is used as a fallback
# when Gemini fails (for example when the free tier hits its rate limit).
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides (normally leave blank):
# LLM_PROVIDER=gemini        # gemini | xai | anthropic: which provider goes first (auto from the keys set)
# LLM_MODEL=                 # model for the first provider
# GEMINI_MODEL=              # per-provider model overrides
# XAI_MODEL=
# ANTHROPIC_MODEL=
