# Paste at least one key. Both of these have free tiers:
#   Gemini: https://aistudio.google.com/apikey
#   Groq (not Grok, key starts with gsk_): https://console.groq.com/keys
# With several keys set, the first one is used and the others are fallbacks
# when it fails (for example when a free tier hits its rate limit).
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional, paid or promotional credits:
# XAI_API_KEY=               # Grok, key starts with xai-
# ANTHROPIC_API_KEY=

# Optional overrides (normally leave blank):
# LLM_PROVIDER=gemini        # gemini | groq | xai | anthropic: which provider goes first (auto from the keys set)
# LLM_MODEL=                 # model for the first provider
# GEMINI_MODEL=              # per-provider model overrides (default gemini-flash-lite-latest; gemini-flash-latest
#                            # is stronger but allows only ~20 free requests a day)
# GROQ_MODEL=
# XAI_MODEL=
# ANTHROPIC_MODEL=
# LLM_TIMEOUT_MS=45000       # give up on a slow provider and try the next one

# Sign-in (Auth.js). AUTH_SECRET signs the session cookie: generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Google sign-in (optional; email + password works without it)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Hosted database (the live demo). Leave empty to use the local file data/prepy.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live demo only (see docs/DEPLOY.md). Leave DEMO_MODE empty locally.
# DEMO_MODE=1                 # shared demo login on the sign-in page, sign-ups limited, daily AI caps
# DEMO_EMAIL=demo@prepy.app   # the shared demo account (created on first use)
# DEMO_PASSWORD=              # shown on the sign-in page, so not a secret
# ALLOWED_SIGNUP_EMAILS=      # comma-separated: the only emails that may create accounts on the demo
# DAILY_AI_LIMIT_PER_USER=150 # AI calls per account per 24 hours (owner accounts are exempt)
# DAILY_AI_LIMIT_TOTAL=600    # AI calls for the whole site per 24 hours
